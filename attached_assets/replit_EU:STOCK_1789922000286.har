            "mimeType": "application/javascript",
            "text": "\"use strict\";(()=>{var B=\"0.6.1-standalone\";var y={HIGHLIGHT_COLOR:\"#0079F2\",HIGHLIGHT_BG:\"#0079F210\",ALLOWED_PARENT_DOMAINS:[\".replit.dev\",\".replit.com\",\".replit-staging.com\",\".replit.corp.repl.it\",\".rp-humain.com\",\".repl.co\"],DEV_VM_WORKSPACE_PORT:\"3000\",THEME_PREVIEW_STYLE_ID:\"replit-theme-preview\",MAX_SIBLING_HIGHLIGHTERS:1e3,MAX_DESCENDANTS_FOR_SCREENSHOT:1500},ae=`\n  [contenteditable] {\n    outline: none !important;\n  }\n\n  [contenteditable]:focus {\n    outline: none !important;\n  }\n`,ce=`\n  .beacon-highlighter {\n    content: '';\n    position: absolute;\n    z-index: ${Number.MAX_SAFE_INTEGER-3};\n    box-sizing: border-box;\n    pointer-events: none;\n    outline: 1.5px dashed ${y.HIGHLIGHT_COLOR} !important;\n    outline-offset: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    transform: none !important;\n    background: ${y.HIGHLIGHT_BG} !important;\n    opacity: 0;\n  }\n  \n  .beacon-hover-highlighter {\n    position: fixed;\n    z-index: ${Number.MAX_SAFE_INTEGER};\n  }\n  \n  .beacon-selected-highlighter {\n    position: fixed;\n    pointer-events: none;\n    outline: 1.5px solid ${y.HIGHLIGHT_COLOR} !important;\n    /* Same offset as the hover highlighter so the ring doesn't shift on\n       click \\u2014 only the dash pattern changes. */\n    outline-offset: 0 !important;\n    background: none !important;\n  }\n  \n  .beacon-label {\n    position: absolute;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    box-sizing: border-box;\n    height: 24px;\n    /* Element pill in the selection color, matching the highlight ring so\n       chip + ring read as one selection system (same reason design tools\n       label selections in their selection blue). Deliberately one constant\n       palette in every theme: the pill floats over arbitrary mockup\n       content, and solid selection-blue with white text holds contrast on\n       any backdrop. */\n    background-color: ${y.HIGHLIGHT_COLOR};\n    color: #FFFFFF;\n    padding: 0 8px;\n    border-radius: 9999px;\n    font-size: 12px;\n    font-weight: 500;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,\n      'Helvetica Neue', Arial, sans-serif;\n    line-height: 1;\n    letter-spacing: 0.01em;\n    white-space: nowrap;\n    /* Layered shadow, macOS-flavored depth \\u2014 y doubles per step; blur\n       stays in the 2-4x-of-y band with variety per layer (tight contact\n       up to a wide ambient). The product Pill has none, but this one\n       floats over arbitrary user content and needs real elevation. */\n    box-shadow:\n      0 1px 2px rgba(0,0,0,0.12),\n      0 2px 6px rgba(0,0,0,0.10),\n      0 4px 12px rgba(0,0,0,0.08),\n      0 8px 32px rgba(0,0,0,0.10);\n    margin-top: 6px;\n    /* The outline paints outside the element box, so pull the chip left\n       by the ring width to sit flush with its outer edge. */\n    margin-left: -1.5px;\n    left: 0;\n    z-index: ${Number.MAX_SAFE_INTEGER-2};\n    pointer-events: none;\n    opacity: 0;\n  }\n\n  .beacon-label svg {\n    flex: none;\n    width: 14px;\n    height: 14px;\n  }\n\n\n  \n  .beacon-hover-label {\n    position: fixed;\n    z-index: ${Number.MAX_SAFE_INTEGER};\n  }\n  \n  .beacon-selected-label {\n    position: fixed;\n    pointer-events: none;\n  }\n  \n  .beacon-sibling-highlighter {\n    position: fixed;\n    pointer-events: none;\n    outline: 1.5px dashed ${y.HIGHLIGHT_COLOR} !important;\n    outline-offset: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    transform: none !important;\n    background: ${y.HIGHLIGHT_BG} !important;\n  }\n`,$={pointer:\"M11.883 13.42c-.246-1.147.892-2.101 1.978-1.66l7.415 3.012c1.286.522 1.188 2.374-.145 2.757l-2.933.843a.894.894 0 0 0-.555.467l-1.34 2.741c-.61 1.246-2.45 1.022-2.742-.335l-1.678-7.825Zm1.468-.402a.104.104 0 0 0-.14.118l1.678 7.825c.02.096.15.111.194.023L16.59 17.9c.173-.354.488-.618.867-.727l3.299-.948a.103