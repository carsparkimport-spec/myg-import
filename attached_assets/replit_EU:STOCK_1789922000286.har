lor: var(--secondary-text-color);\n  }\n\n  .console {\n    background: var(--elevated-surface-color);\n    border: 1px solid var(--surface-border-color);\n    border-radius: 8px;\n    padding: 16px;\n    margin: 24px 0;\n    font-family: ui-monospace, monospace;\n    text-align: left;\n    overflow-wrap: anywhere;\n  }\n\n  .footer,\n  .footer-item {\n    margin-top: 16px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .link-icon {\n    display: flex;\n    flex: none;\n    color: var(--secondary-text-color);\n  }\n\n  .link-icon path {\n    stroke: currentColor;\n  }\n\n  .repl-links {\n    min-width: 0;\n    overflow-wrap: anywhere;\n  }\n\n  a {\n    color: var(--secondary-text-color);\n    text-underline-offset: 4px;\n  }\n\n  a:hover {\n    color: var(--text-color);\n  }\n\n  a:focus-visible,\n  button:focus-visible {\n    outline: 2px solid var(--text-color);\n    outline-offset: 4px;\n    border-radius: 4px;\n  }\n</style>\n\n\n  <script>\n    var reload_timeout = setTimeout(function () {\n      window.location.reload();\n    }, 60000);\n  </script>\n</head>\n\n<body>\n  <div class=\"err-box\">\n    <div class=\"message\">\n      <div class=\"eval-bot\">\n        <pre class=\"ascii\">\n                                  :::.                                                    \n                                :+++***++:..                                              \n                      :-=+=..:-=+**=======---:                                            \n                     -+++****+====-::-=====-::. ..   ..       ::                          \n                    .=++++++=::----------::-::::::--------===--:.:::::.                   \n                   :--==+++=-::----------======----------:-===-:::::::.                   \n                   ::--==+++-----=+++=+++++====----======--==------::                     \n                  ::::-====+++++++*************+==========---------::..                   