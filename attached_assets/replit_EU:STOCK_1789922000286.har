          "content": {
            "size": 5800,
            "mimeType": "text/html",
            "compression": -19,
            "text": "<!doctype html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n    <style>\n      html,\n      body,\n      iframe {\n        margin: 0;\n        padding: 0;\n        border: 0;\n        font-size: 100%;\n        font: inherit;\n        vertical-align: baseline;\n        height: 100%;\n        width: 100%;\n      }\n      body {\n        overflow: hidden;\n      }\n    </style>\n  </head>\n  <body>\n    <iframe\n      id=\"iframe\"\n      sandbox=\"allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-modals allow-downloads allow-downloads-without-user-activation allow-presentation allow-orientation-lock allow-scripts allow-pointer-lock\"\n      allow=\"accelerometer; ambient-light-sensor; autoplay; battery; camera; display-capture; encrypted-media; execution-while-not-rendered; execution-while-out-of-viewport; fullscreen; gamepad; geolocation; gyroscope; layout-animations; legacy-image-formats; magnetometer; microphone; midi; navigation-override; oversized-images; payment; picture-in-picture; publickey-credentials; speaker-selection; sync-xhr; unoptimized-images; unsized-media; serial; usb; screen-wake-lock; web-share; xr-spatial-tracking; clipboard-read; clipboard-write\"\n      allowfullscreen=\"true\"\n      allowtransparency=\"true\"\n      allowpaymentrequest=\"true\"\n      allowpopups=\"true\"\n    ></iframe>\n    <script>\n      const iframe = document.getElementById('iframe');\n      const urlParams = new URLSearchParams(window.location.search);\n      const initialPath = urlParams.get('initialPath') || '/';\n      const webviewId = urlParams.get('id') || null;\n\n      const WORKSPACE_ORIGINS = [\n        'https://replit.com',\n        'https://staging.replit.com',\n        'https://replit-staging.com',\n        'https://firewalledreplit.com',\n        'https://staging.firewalledreplit.com',\n        'http://localhost:3000',\n        'https://rp-humain.com',\n        'https://replit.corp.repl.it',\n      ];\n\n      \n\n      function postMessageToWorkspace(data) {\n        const dataWithPaneId = { ...data, id: webviewId };\n\n        for (const origin of WORKSPACE_ORIGINS) {\n          parent?.postMessage(dataWithPaneId, origin);\n        }\n      }\n\n      window.addEventListener('message', (event) => {\n        if (\n          typeof event.data !== 'object' ||\n          event.data === null ||\n          !('type' in event.data)\n        ) {\n          \n          return;\n        }\n\n        if (event.origin === window.location.origin) {\n          \n          postMessageToWorkspace(event.data);\n\n          return;\n        }\n\n        if (WORKSPACE_ORIGINS.indexOf(event.origin) === -1) {\n          return;\n        }\n\n        iframe.contentWindow.postMessage(event.data, window.location.origin);\n      });\n\n      function canAccessIframeWindow() {\n        try {\n          iframe.contentWindow.document.body;\n          return true;\n        } catch (err) {\n          return false;\n        }\n      }\n\n      \n      \n      \n      \n      async function checkThirdPartyCookie() {\n        let enabled = false;\n        if ('hasStorageAccess' in document) {\n          enabled = await document.hasStorageAccess();\n        }\n\n        if (!enabled) {\n          const testCookieName = '__replit_third_party_cookie_test__';\n          document.cookie = `${testCookieName}=1;`;\n          enabled = document.cookie.indexOf(testCookieName) !== -1;\n          \n          document.cookie = `${testCookieName}=1; max-age=0;`;\n        }\n        \n        postMessageToWorkspace({\n          type: 'third-party-cookie-check',\n          payload: {\n            enabled\n          }\n        });\n      }\n\n      function postLocation() {\n        if (!canAccessIframeWindow()) {\n          postMessageToWorkspace({\n            type: 'page-navigation',\n            payload: {\n              isExternal: true,\n            },\n          });\n\n          return;\n        }\n\n        postMessageToWorkspace({\n          type: 'page-navigation',\n          payload: {\n            isExternal: false,\n            relativeUrl:\n              iframe.contentWindow.location.pathname +\n              iframe.contentWindow.location.search +\n              iframe.contentWindow.location.hash,\n          },\n        });\n      }\n      function onIframeLoad() {\n        \n        \n        postLocation();\n        \n        \n        checkThirdPartyCookie();\n\n        if (canAccessIframeWindow()) {\n          let navigationStarted = false;\n          function postNavigationStart() {\n            if (navigationStarted) {\n              return;\n            }\n\n            navigationStarted = true;\n            postMessageToWorkspace({ type: 'page-navigation-start' });\n          }\n\n          iframe.contentWindow.addEventListener('pagehide', postNavigationStart);\n          iframe.contentWindow.addEventListener('pageshow', (event) => {\n            if (event.persisted) {\n              navigationStarted = false;\n              postLocation();\n            }\n          });\n\n          \n          const script = document.createElement('script');\n          script.type = 'text/javascript';\n          script.src = 'https://replit.com/public/js/replit-bridge.js';\n          iframe.contentDocument.head.appendChild(script);\n          \n          \n          iframe.contentWindow.addEventListener('popstate', postLocation);\n          iframe.contentWindow.addEventListener('hashchange', postLocation);\n          iframe.contentWindow.addEventListener('__replit-history-event', postLocation);\n        }\n      }\n      iframe.addEventListener('load', onIframeLoad);\n      const resolvedUrl = new URL(initialPath, window.location.origin);\n      \n      \n      \n      \n      if (resolvedUrl.origin === window.location.origin) {\n        iframe.src = resolvedUrl.href;\n      } else {\n        iframe.src = new URL('/', window.location.origin).href;\n      }\n    </script>\n  </body>\n</html>\n"
